# Market Data API Configuration
# Copy this file to .env and provide your API key.
# Never commit your actual .env file or expose keys in client-side code.

# Preferred provider: "polygon" | "alphavantage" | "yahoo"
MARKET_DATA_PROVIDER=polygon

# Polygon.io API Key (Free tier available at https://polygon.io/)
POLYGON_API_KEY=your_polygon_api_key_here

# Alpha Vantage API Key (Free tier available at https://www.alphavantage.co/)
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Server port
PORT=3000
